# Kenshin — environment template (.env.example)
# Copy to `.env` in the repo root, or merge into your process / Docker env.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# API (FastGraphQL / FastAPI) — load from `api/` or set in docker-compose
# -----------------------------------------------------------------------------
# Required. Async SQLAlchemy URL, e.g. Postgres:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_db

# Required in production. Used to sign JWTs for GraphQL auth.
JWT_SECRET=dev-jwt-secret-change-in-production

# If 1/true/yes/on: on each API boot, reset dev admin password/role (see README).
# Disable in production.
KENSHIN_SYNC_DEV_ADMIN=1

# Optional. Google AI Studio key for `recommendCheckups` (AI screening suggestions).
# Leave empty to skip Gemini features until configured.
GEMINI_API_KEY=

# Optional. Gemini model id (default in code: gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Remix (frontend) — read by the Node server (loaders/actions, graphql-client)
# -----------------------------------------------------------------------------
# Base URL of the API as seen from the Remix server (not the browser).
API_URL=http://localhost:8000

# Secret for the session cookie (JWT is stored in session). Change in production.
SESSION_SECRET=dev-session-secret-change-me

# NODE_ENV is usually set by the Remix/Vite toolchain; production enables secure cookies.

# -----------------------------------------------------------------------------
# Docker Compose (optional — often set in shell or a `.env` next to compose file)
# -----------------------------------------------------------------------------
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=fastapi_db
